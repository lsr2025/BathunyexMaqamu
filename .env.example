# ──────────────────────────────────────────────────────────────
#  Nokulunga's Journey to MammaLand — Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in the values from your
# Supabase project dashboard (Project Settings → API).

# Public Supabase URL (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon / publishable key (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Name of the public Storage bucket for photo & video memories.
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=memories

# Public site URL — used to generate the printable QR code.
NEXT_PUBLIC_SITE_URL=https://nokulunga-mammaland.vercel.app

# ──────────────────────────────────────────────────────────────
#  Admin password
#  The /admin panel is gated by a password stored IN THE DATABASE
#  (public.app_settings, read only by the admin_export SQL function),
#  so no service-role key is needed in the app. Change it with:
#
#    update public.app_settings set value = 'your-new-password'
#    where key = 'admin_password';
# ──────────────────────────────────────────────────────────────
